# URL base del backend (opcional; por defecto usa proxy /api/eventos)
# Desarrollo local sin Docker: dejar sin definir o usar /api/eventos
# VITE_API_URL=http://localhost:8080/eventos

# Proxy de Vite hacia el backend (solo docker-compose; el servicio backend resuelve en la red interna)
# VITE_PROXY_TARGET=http://backend:8080
